# Copy this file to .env and fill in your values
# Never commit .env to git

# LLM Provider 
OPENAI_API_KEY=your_openai_key_here

# Which provider to use
LLM_PROVIDER=openai

# Model selection
OPENAI_MODEL=gpt-4o

# App settings
APP_ENV=development
LOG_LEVEL=INFO

# Processing
MAX_FILE_SIZE_MB=50
OCR_ENABLED=true
